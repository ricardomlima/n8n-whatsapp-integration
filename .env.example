# =============================================================================
# Environment Configuration for n8n + Evolution API Deployment
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
NODE_ENV=production
TIMEZONE=America/Sao_Paulo

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=n8n

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PASSWORD=your_redis_password_here

# -----------------------------------------------------------------------------
# n8n Configuration
# -----------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=0.0.0.0
N8N_PROTOCOL=http
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_admin_password_here
N8N_WEBHOOK_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=your_32_character_encryption_key_here

# For production deployment, update these:
# N8N_HOST=your-domain.com
# N8N_PROTOCOL=https
# N8N_WEBHOOK_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# Evolution API Configuration
# -----------------------------------------------------------------------------
EVOLUTION_PORT=8080
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_WEBHOOK_URL=http://n8n:5678/webhook

# For production deployment, update these:
# EVOLUTION_SERVER_URL=https://evolution-api.your-domain.com
# EVOLUTION_WEBHOOK_URL=https://your-domain.com/webhook

# -----------------------------------------------------------------------------
# AWS Configuration (for CDK deployment)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id
DOMAIN_NAME=your-domain.com
CERTIFICATE_ARN=arn:aws:acm:region:account:certificate/cert-id

# -----------------------------------------------------------------------------
# Environment-specific Configuration
# -----------------------------------------------------------------------------
# For development
# ENVIRONMENT=development

# For production
# ENVIRONMENT=production
